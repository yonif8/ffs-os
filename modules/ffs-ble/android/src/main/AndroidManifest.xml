<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Declared here as well as in app.json so the module is self-contained: whatever
       app embeds ffs-ble gets the permissions its driver actually needs, via manifest
       merge. Android 12+ (API 31) split the old BLUETOOTH/BLUETOOTH_ADMIN into these
       runtime permissions; the target phone is Android 13 (API 33). -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <!-- Legacy (API <= 30) BLE scanning required location. Kept with maxSdkVersion so it
       is not requested on the API 31+ path, where BLUETOOTH_SCAN covers it. -->
  <uses-permission
    android:name="android.permission.ACCESS_FINE_LOCATION"
    android:maxSdkVersion="30" />
  <uses-permission
    android:name="android.permission.BLUETOOTH"
    android:maxSdkVersion="30" />
  <uses-permission
    android:name="android.permission.BLUETOOTH_ADMIN"
    android:maxSdkVersion="30" />

  <uses-feature
    android:name="android.hardware.bluetooth_le"
    android:required="true" />

</manifest>
